+test('Pi Go answers only the owning manager and wins at most once against Desktop', () => {
+  const h = createHarness([WS_A, WS_B])
+  const owner = h.managers.get(WS_A)!
+  const other = h.managers.get(WS_B)!
+  const first = { type: 'extension_ui_request', method: 'confirm', id: 'mobile-first' } as const
+  owner.emit('event', first)
+  assert.equal(h.router.pendingForPiGo(other), undefined)
+  assert.equal(h.router.respondFromPiGo(other, first.id, true), false)
+  assert.equal(h.router.respondFromPiGo(owner, first.id, 'true'), false)
+  assert.equal(h.router.respondFromPiGo(owner, first.id, true), true)
+  assert.deepEqual(h.broadcasts.at(-1), { ...first, method: 'cancel', targetId: first.id })
+  h.router.respond(first.id, { confirmed: false })
+  assert.equal(h.router.respondFromPiGo(owner, first.id, true), false)
+  const second = { type: 'extension_ui_request', method: 'select', id: 'desktop-first', options: ['one', 'two'] } as const
+  owner.emit('event', second)
+  assert.equal(h.router.respondFromPiGo(owner, second.id, 'three'), false)
+  h.router.respond(second.id, { value: 'two' })
+  assert.equal(h.router.respondFromPiGo(owner, second.id, 'one'), false)
+  assert.deepEqual(h.responses, [
+    { workspaceId: WS_A, id: first.id, response: { confirmed: true } },
+    { workspaceId: WS_A, id: second.id, response: { value: 'two' } },
+  ])
+})
+
+test('Pi Go preserves editor whitespace, cancels inputs and rejects oversized or multiline input', () => {
+  const h = createHarness([WS_A])
+  const owner = h.managers.get(WS_A)!
+  owner.emit('event', { type: 'extension_ui_request', method: 'input', id: 'input', placeholder: 'Answer' })
+  assert.equal(h.router.pendingForPiGo(owner)?.placeholder, 'Answer')
+  assert.equal(h.router.respondFromPiGo(owner, 'input', 'some\ntext'), false)
+  assert.equal(h.router.respondFromPiGo(owner, 'input', 'x'.repeat(1025)), false)
+  assert.equal(h.router.respondFromPiGo(owner, 'input', false), true)
+  owner.emit('event', { type: 'extension_ui_request', method: 'editor', id: 'edit', prefill: 'original\n' })
+  assert.equal(h.router.pendingForPiGo(owner)?.prefill, 'original\n')
+  assert.equal(h.router.respondFromPiGo(owner, 'edit', '  new\n'), true)
+  owner.emit('event', { type: 'extension_ui_request', method: 'editor', id: 'long', prefill: 'x'.repeat(1025) })
+  assert.equal(h.router.pendingForPiGo(owner), undefined)
+  assert.equal(h.router.respondFromPiGo(owner, 'long', ''), false)
+  assert.deepEqual(h.responses, [
+    { workspaceId: WS_A, id: 'input', response: { cancelled: true } },
+    { workspaceId: WS_A, id: 'edit', response: { value: '  new\n' } },
+  ])
+})
+
