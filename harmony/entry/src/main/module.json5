{
  "module": {
    "name": "entry",
    "type": "entry",
    "mainElement": "EntryAbility",
    "deviceTypes": ["phone", "tablet"],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "metadata": [
      { "name": "client_id", "value": "6917622368458448041" },
      {
        "name": "ohos.arkui.UIMaterial.state",
        "value": "enable"
      }
    ],
    "requestPermissions": [
      { "name": "ohos.permission.INTERNET" },
      { "name": "ohos.permission.GET_NETWORK_INFO" },
      {
        "name": "ohos.permission.MICROPHONE",
        "reason": "$string:microphone_permission",
        "usedScene": { "abilities": ["EntryAbility"], "when": "inuse" }
      }
    ],
    "abilities": [{
      "name": "EntryAbility",
      "srcEntry": "./ets/EntryAbility.ets",
      "launchType": "singleton",
      "label": "$string:app_name",
      "icon": "$media:pigo",
      "startWindowIcon": "$media:pigo",
      "startWindowBackground": "$color:launch_background",
      "exported": true,
      "skills": [
        { "entities": ["entity.system.home"], "actions": ["ohos.want.action.home"] },
        {
          "actions": ["ohos.want.action.sendData"],
          "uris": [
            { "scheme": "file", "utd": "general.image", "maxFileSupported": 4 },
            { "scheme": "file", "utd": "general.text", "maxFileSupported": 1 },
            { "scheme": "file", "utd": "general.hyperlink", "maxFileSupported": 1 }
          ]
        }
      ]
    }],
    "extensionAbilities": [{
      "name": "InboxFormAbility",
      "srcEntry": "./ets/InboxFormAbility.ets",
      "type": "form",
      "label": "$string:inbox_form_name",
      "description": "$string:inbox_form_description",
      "exported": true,
      "metadata": [{ "name": "ohos.extension.form", "resource": "$profile:inbox_form" }]
    }]
  }
}
